{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "CORTEXTOS_ROOT=\"${CTX_FRAMEWORK_ROOT:-$HOME/cortextos}\"; CORTEXTOS_ROOT=\"$(cygpath -u \"$CORTEXTOS_ROOT\" 2>/dev/null || printf '%s' \"$CORTEXTOS_ROOT\")\"; \"$CORTEXTOS_ROOT/bin/cortextos-hook.sh\" bus hook-planmode-telegram",
            "timeout": 1860
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "CORTEXTOS_ROOT=\"${CTX_FRAMEWORK_ROOT:-$HOME/cortextos}\"; CORTEXTOS_ROOT=\"$(cygpath -u \"$CORTEXTOS_ROOT\" 2>/dev/null || printf '%s' \"$CORTEXTOS_ROOT\")\"; \"$CORTEXTOS_ROOT/bin/cortextos-hook.sh\" bus hook-permission-telegram",
            "timeout": 1860
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CORTEXTOS_ROOT=\"${CTX_FRAMEWORK_ROOT:-$HOME/cortextos}\"; CORTEXTOS_ROOT=\"$(cygpath -u \"$CORTEXTOS_ROOT\" 2>/dev/null || printf '%s' \"$CORTEXTOS_ROOT\")\"; \"$CORTEXTOS_ROOT/bin/cortextos-hook.sh\" bus hook-loop-detector",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "CORTEXTOS_ROOT=\"${CTX_FRAMEWORK_ROOT:-$HOME/cortextos}\"; CORTEXTOS_ROOT=\"$(cygpath -u \"$CORTEXTOS_ROOT\" 2>/dev/null || printf '%s' \"$CORTEXTOS_ROOT\")\"; \"$CORTEXTOS_ROOT/bin/cortextos-hook.sh\" bus hook-ask-telegram",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CORTEXTOS_ROOT=\"${CTX_FRAMEWORK_ROOT:-$HOME/cortextos}\"; CORTEXTOS_ROOT=\"$(cygpath -u \"$CORTEXTOS_ROOT\" 2>/dev/null || printf '%s' \"$CORTEXTOS_ROOT\")\"; \"$CORTEXTOS_ROOT/bin/cortextos-hook.sh\" bus hook-idle-flag",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CORTEXTOS_ROOT=\"${CTX_FRAMEWORK_ROOT:-$HOME/cortextos}\"; CORTEXTOS_ROOT=\"$(cygpath -u \"$CORTEXTOS_ROOT\" 2>/dev/null || printf '%s' \"$CORTEXTOS_ROOT\")\"; \"$CORTEXTOS_ROOT/bin/cortextos-hook.sh\" crash-alert",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CORTEXTOS_ROOT=\"${CTX_FRAMEWORK_ROOT:-$HOME/cortextos}\"; CORTEXTOS_ROOT=\"$(cygpath -u \"$CORTEXTOS_ROOT\" 2>/dev/null || printf '%s' \"$CORTEXTOS_ROOT\")\"; \"$CORTEXTOS_ROOT/bin/cortextos-hook.sh\" bus hook-compact-telegram",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
